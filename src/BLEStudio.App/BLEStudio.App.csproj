<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BLEStudio</AssemblyName>
    <RootNamespace>BLEStudio.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../BLEStudio.Core/BLEStudio.Core.csproj" />
    <ProjectReference Include="../BLEStudio.Bluetooth/BLEStudio.Bluetooth.csproj" />
    <ProjectReference Include="../BLEStudio.Protocols/BLEStudio.Protocols.csproj" />
    <ProjectReference Include="../BLEStudio.Infrastructure/BLEStudio.Infrastructure.csproj" />
    <EmbeddedResource Include="../../profiles/*.json" Link="Profiles/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
