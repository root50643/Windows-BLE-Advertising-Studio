FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN git clone --filter=blob:none https://github.com/dchristl/macless-haystack.git /app && cd /app && git checkout 0bda271b8bd0cc37194dfba1845cd48954cba4cc
WORKDIR /app
RUN pip install --no-cache-dir -r endpoint/requirements.txt
# Pinned source: intentionally bypass upstream's automatic source updater.
CMD ["python", "-u", "endpoint/mh_endpoint.py"]
